{
  "entities": {
    "recipes": {
      "title": "Recipe",
      "description": "Bakery recipes with base yields, formulations, and ingredients bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "batchYieldQuantity": { "type": "number" },
        "batchYieldUnit": { "type": "string" },
        "defaultWastePercent": { "type": "number" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["workspaceId", "name", "batchYieldQuantity", "batchYieldUnit"]
    },
    "presets": {
      "title": "Production Preset",
      "description": "Reusable product packaging and item weight presets bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "finishedWeight": { "type": "number" },
        "weightUnit": { "type": "string" },
        "quantityPerUnit": { "type": "number" },
        "unitName": { "type": "string" },
        "expectedYield": { "type": "string" },
        "productionEnabled": { "type": "boolean" }
      },
      "required": ["workspaceId", "name", "finishedWeight", "weightUnit", "quantityPerUnit"]
    },
    "mixers": {
      "title": "Mixer Capacity",
      "description": "Equipment mixer details and safe batch capacities bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "maxWeight": { "type": "number" },
        "weightUnit": { "type": "string" }
      },
      "required": ["workspaceId", "name", "maxWeight", "weightUnit"]
    },
    "history": {
      "title": "Production History",
      "description": "Saved production calculations and batch sheets bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "recipeId": { "type": "string" },
        "recipeName": { "type": "string" },
        "calculatedAt": { "type": "string" },
        "totalPieces": { "type": "number" },
        "scalingMultiplier": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["workspaceId", "recipeName", "calculatedAt"]
    },
    "master_ingredients": {
      "title": "Master Ingredient",
      "description": "Master pantry ingredients and specifications bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "defaultUnit": { "type": "string" },
        "defaultWastePercent": { "type": "number" },
        "subIngredients": { "type": "string" },
        "allergens": { "type": "string" }
      },
      "required": ["workspaceId", "name"]
    },
    "settings": {
      "title": "User Settings",
      "description": "Individual user preferences and application configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "defaultWeightUnit": { "type": "string" },
        "defaultWastePercent": { "type": "number" },
        "theme": { "type": "string" },
        "decimalPlaces": { "type": "number" },
        "activeWorkspaceId": { "type": "string" }
      },
      "required": ["userId", "defaultWeightUnit"]
    },
    "workspaces": {
      "title": "Workspace",
      "description": "Bakery workspace entity with ownership and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "code": { "type": "string" },
        "members": { "type": "array" },
        "groups": { "type": "array" },
        "branding": {
          "type": "object",
          "properties": {
            "displayName": { "type": "string" },
            "logoUrl": { "type": "string" },
            "logoStoragePath": { "type": "string" },
            "paletteId": { "type": "string" }
          }
        },
        "productionOptionOrder": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "workspace_members": {
      "title": "Workspace Member",
      "description": "Membership document enforcing zero-trust role-based access control",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "editor", "viewer"] },
        "active": { "type": "boolean" },
        "addedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "workspace_billing": {
      "title": "Workspace Billing & Entitlements",
      "description": "Authoritative SaaS subscription, seat limits, and entitlement state managed exclusively by server billing logic",
      "type": "object",
      "properties": {
        "planId": { "type": "string", "enum": ["internal", "solo", "team"] },
        "subscriptionStatus": { "type": "string", "enum": ["internal", "trialing", "active", "past_due", "canceled", "incomplete", "paused", "expired"] },
        "entitlementStatus": { "type": "string", "enum": ["active", "restricted", "inactive"] },
        "trialStartedAt": { "type": "string" },
        "trialEndsAt": { "type": "string" },
        "stripeCustomerId": { "type": "string" },
        "stripeSubscriptionId": { "type": "string" },
        "stripePriceId": { "type": "string" },
        "seatLimit": { "type": "number" },
        "activeSeatCount": { "type": "number" },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "currentPeriodStart": { "type": "string" },
        "currentPeriodEnd": { "type": "string" },
        "billingUpdatedAt": { "type": "string" },
        "billingSource": { "type": "string", "enum": ["internal", "stripe"] }
      },
      "required": ["planId", "subscriptionStatus", "entitlementStatus", "billingUpdatedAt", "billingSource"]
    },
    "users": {
      "title": "User Account Profile",
      "description": "User account profile and default workspace preference",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "defaultWorkspaceId": { "type": "string" },
        "onboardingStatus": { "type": "string", "enum": ["pending_workspace", "workspace_created"] }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "user_workspace_memberships": {
      "title": "User Workspace Membership Index",
      "description": "Index mapping user UIDs to workspaces for efficient discovery without global scans",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "editor", "viewer"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["workspaceId", "role", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User account profile and onboarding state"
    },
    "/users/{userId}/workspaceMemberships/{workspaceId}": {
      "schema": "user_workspace_memberships",
      "description": "Index of workspaces that the user belongs to"
    },
    "/workspaces/{workspaceId}": {
      "schema": "workspaces",
      "description": "Workspace root document holding metadata and legacy member arrays"
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": "workspace_members",
      "description": "Granular user membership document for secure zero-trust RBAC"
    },
    "/workspaces/{workspaceId}/billing/{billingDoc}": {
      "schema": "workspace_billing",
      "description": "Workspace-scoped billing record (read-only for members, written strictly by authoritative server-side billing infrastructure)"
    },
    "/recipes/{recipeId}": {
      "schema": "recipes",
      "description": "Workspace-isolated recipes and formulation data"
    },
    "/presets/{presetId}": {
      "schema": "presets",
      "description": "Workspace-isolated packaging presets"
    },
    "/mixers/{mixerId}": {
      "schema": "mixers",
      "description": "Workspace-isolated mixing equipment"
    },
    "/history/{historyId}": {
      "schema": "history",
      "description": "Workspace-isolated batch production logs"
    },
    "/master_ingredients/{ingredientId}": {
      "schema": "master_ingredients",
      "description": "Workspace-isolated master pantry ingredients"
    },
    "/settings/{userId}": {
      "schema": "settings",
      "description": "User-private preferences and configurations"
    }
  }
}

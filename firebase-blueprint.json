{
  "entities": {
    "recipes": {
      "title": "Recipe",
      "description": "Bakery recipes with base yields, formulations, and ingredients bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "batchYieldQuantity": { "type": "number" },
        "batchYieldUnit": { "type": "string" },
        "defaultWastePercent": { "type": "number" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["workspaceId", "name", "batchYieldQuantity", "batchYieldUnit"]
    },
    "presets": {
      "title": "Production Preset",
      "description": "Reusable product packaging and item weight presets bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "finishedWeight": { "type": "number" },
        "weightUnit": { "type": "string" },
        "quantityPerUnit": { "type": "number" },
        "unitName": { "type": "string" },
        "expectedYield": { "type": "string" }
      },
      "required": ["workspaceId", "name", "finishedWeight", "weightUnit", "quantityPerUnit"]
    },
    "mixers": {
      "title": "Mixer Capacity",
      "description": "Equipment mixer details and safe batch capacities bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "maxWeight": { "type": "number" },
        "weightUnit": { "type": "string" }
      },
      "required": ["workspaceId", "name", "maxWeight", "weightUnit"]
    },
    "history": {
      "title": "Production History",
      "description": "Saved production calculations and batch sheets bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "recipeId": { "type": "string" },
        "recipeName": { "type": "string" },
        "calculatedAt": { "type": "string" },
        "totalPieces": { "type": "number" },
        "scalingMultiplier": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["workspaceId", "recipeName", "calculatedAt"]
    },
    "master_ingredients": {
      "title": "Master Ingredient",
      "description": "Master pantry ingredients and specifications bound to a workspace",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "defaultUnit": { "type": "string" },
        "defaultWastePercent": { "type": "number" },
        "subIngredients": { "type": "string" },
        "allergens": { "type": "string" }
      },
      "required": ["workspaceId", "name"]
    },
    "settings": {
      "title": "User Settings",
      "description": "Individual user preferences and application configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "defaultWeightUnit": { "type": "string" },
        "defaultWastePercent": { "type": "number" },
        "theme": { "type": "string" },
        "decimalPlaces": { "type": "number" },
        "activeWorkspaceId": { "type": "string" }
      },
      "required": ["userId", "defaultWeightUnit"]
    },
    "workspaces": {
      "title": "Workspace",
      "description": "Bakery workspace entity with ownership and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "code": { "type": "string" },
        "members": { "type": "array" },
        "groups": { "type": "array" },
        "branding": {
          "type": "object",
          "properties": {
            "displayName": { "type": "string" },
            "logoUrl": { "type": "string" },
            "logoStoragePath": { "type": "string" },
            "paletteId": { "type": "string" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "workspace_members": {
      "title": "Workspace Member",
      "description": "Membership document enforcing zero-trust role-based access control",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["owner", "editor", "viewer"] },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["role", "email"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": "workspaces",
      "description": "Workspace root document holding metadata and legacy member arrays"
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": "workspace_members",
      "description": "Granular user membership document for secure zero-trust RBAC"
    },
    "/recipes/{recipeId}": {
      "schema": "recipes",
      "description": "Workspace-isolated recipes and formulation data"
    },
    "/presets/{presetId}": {
      "schema": "presets",
      "description": "Workspace-isolated packaging presets"
    },
    "/mixers/{mixerId}": {
      "schema": "mixers",
      "description": "Workspace-isolated mixing equipment"
    },
    "/history/{historyId}": {
      "schema": "history",
      "description": "Workspace-isolated batch production logs"
    },
    "/master_ingredients/{ingredientId}": {
      "schema": "master_ingredients",
      "description": "Workspace-isolated master pantry ingredients"
    },
    "/settings/{userId}": {
      "schema": "settings",
      "description": "User-private preferences and configurations"
    }
  }
}
